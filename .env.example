# Скопируйте в .env: cp .env.example .env

# Подключение к PostgreSQL (совпадает с docker-compose.yml)
DATABASE_URL="postgresql://prompool:prompool@localhost:5432/prompool?schema=public"

# Ключ API производителя (запись в каталог), пока нет входа в аккаунт. Пусто — API выключено.
# В продакшене задайте свой:
# Сгенерировать: openssl rand -hex 24
SELLER_API_TOKEN="local-dev-seller-token-change-me"
