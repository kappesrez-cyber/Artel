# Скопируйте в .env: cp .env.example .env

# Подключение к PostgreSQL.
# По умолчанию — локальная база `npm run db:start` (Docker не нужен).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Вторая база той же команды, нужна только `npm run db:migrate`.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Вместо этого PostgreSQL в Docker (`npm run db:up`): закомментируйте строки выше и раскомментируйте эту.
# DATABASE_URL="postgresql://prompool:prompool@localhost:5432/prompool?schema=public"

# Ключ API производителя (запись в каталог), пока нет входа в аккаунт. Пусто — API выключено.
# В продакшене задайте свой:
# Сгенерировать: openssl rand -hex 24
SELLER_API_TOKEN="local-dev-seller-token-change-me"
